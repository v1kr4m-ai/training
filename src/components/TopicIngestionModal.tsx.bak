import React, { useState, useRef } from 'react';
import { Topic } from '../types';
import { ALL_TRACK_DEPARTMENTS } from '../data/departments';
import { parseTopicTable, topicTemplateCsv, TOPIC_TEMPLATE_HEADER } from '../utils/topicImport';
import { downloadBlob } from '../utils/exporters';
import * as XLSX from 'xlsx';
import { Upload, FileSpreadsheet, CheckCircle, AlertCircle, Sparkles, RotateCcw, ClipboardCheck } from 'lucide-react';
import Papa from 'papaparse';

interface TopicIngestionModalProps {
  isOpen: boolean;
  onClose: () => void;
  onImportTopics: (newTopics: Topic[], mode: 'REPLACE' | 'APPEND') => void;
  currentTopics: Topic[];
}

export const TopicIngestionModal: React.FC<TopicIngestionModalProps> = ({
  isOpen,
  onClose,
  onImportTopics,
  currentTopics
}) => {
  const [rawPastedText, setRawPastedText] = useState('');
  const [parsedPreview, setParsedPreview] = useState<Topic[]>([]);
  const [parseErrors, setParseErrors] = useState<string[]>([]);
  const [importMode, setImportMode] = useState<'REPLACE' | 'APPEND'>('REPLACE');
  const fileInputRef = useRef<HTMLInputElement>(null);

  if (!isOpen) return null;

  const handleParseText = () => {
    const { topics, errors } = parseTopicTable(rawPastedText, importMode === 'APPEND' ? currentTopics : []);
    setParsedPreview(topics);
    setParseErrors(errors);
  };

  const downloadTemplate = () => downloadBlob(topicTemplateCsv(), 'training-topics-template.csv', 'text/csv;charset=utf-8');

  const readAndParseFile = (file: File): Promise<{ topics: Topic[]; errors: string[] }> => {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = (e: ProgressEvent<FileReader>) => {
        const data = e.target?.result as string;
        const topics: Topic[] = [];
        const errors: string[] = [];

        if (file.name.endsWith('.xlsx') || file.name.endsWith('.xls')) {
          // Excel file
          try {
            const workbook = XLSX.read(e.target!.result as ArrayBuffer, { type: 'binary' });
            const firstSheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[firstSheetName];
            const csv = XLSX.utils.sheet_to_csv(worksheet);
            const parsed = Papa.parse(csv, { header: true, dynamicTyping: false });

            if (parsed.data && parsed.data.length > 0) {
              parsed.data.forEach((row: any, rowIdx: number) => {
                const title = row.title || row['Topic Title'] || row['Topic'];
                const department = row.department || row['Department'] || row['Dept'];
                const speaker = row.speaker || row['Speaker'] || row['Instructor'];
                const prerequisite = row.prerequisite || row['Prerequisite'] || row['prereq'];
                const venue = row.venue || row['Venue'] || row['Location'];
                const description = row.description || row['Description'];

                if (!title || !department) {
                  errors.push(Row : missing title or department);
                  return;
                }

                // Validate department against allowable values
                const depKey = String(department).toLowerCase().replace(/[\s-]+/g, '');
                const validDept = ALL_TRACK_DEPARTMENTS.find(d => d.toLowerCase().replace(/[\s-]+/g, '') === depKey);
                if (!validDept) {
                  errors.push(Row  (""): department "" is not valid);
                  return;
                }

                let id = row.id || row['ID'];
                if (!id) {
                  const nextNum = currentTopics.reduce((m, t) => Math.max(m, Number(/^T-(\d+)$/.exec(t.id)?.[1] || 0)), 0) + 1;
                  id = T-;
                }

                topics.push({
                  id,
                  title: String(title),
                  department: validDept,
                  subDepartment: row['subdepartment'] || row['Sub-Department'] || row['sub department'] || '',
                  speaker: String(speaker || ''),
                  prerequisiteId: prerequisite ? String(prerequisite) : undefined,
                  venue: String(venue || ''),
                  description: String(description || ''),
                  durationMinutes: row['durationMinutes'] ? Number(row['durationMinutes']) : 60,
                  learningOutcomes: row['learningOutcomes'] ? String(row['learningOutcomes']).split(',').map(s => s.trim()).filter(s => s) : undefined,
                  tags: row.tags ? String(row.tags).split(',').map(s => s.trim()).filter(s => s) : undefined,
                  level: row.level ? String(row.level) as 'Fundamental' | 'Intermediate' | 'Advanced' | 'Executive' : undefined
                });
              });
            }
          } catch (err) {
            errors.push(Error reading Excel file: );
          }
        } else {
          // CSV or TSV — read as text
          try {
            const parsed = Papa.parse(data, { header: true, dynamicTyping: false });

            if (parsed.data && parsed.data.length > 0) {
              parsed.data.forEach((row: any, rowIdx: number) => {
                const title = row.title || row['Topic Title'] || row['Topic'];
                const department = row.department || row['Department'] || row['Dept'];
                const speaker = row.speaker || row['Speaker'] || row['Instructor'];
                const prerequisite = row.prerequisite || row['Prerequisite'] || row['prereq'];
                const venue = row.venue || row['Venue'] || row['Location'];
                const description = row.description || row['Description'];

                if (!title || !department) {
                  errors.push(Row : missing title or department);
                  return;
                }

                const depKey = String(department).toLowerCase().replace(/[\s-]+/g, '');
                const validDept = ALL_TRACK_DEPARTMENTS.find(d => d.toLowerCase().replace(/[\s-]+/g, '') === depKey);
                if (!validDept) {
                  errors.push(Row  (""): department "" is not valid);
                  return;
                }

                let id = row.id || row['ID'];
                if (!id) {
                  const nextNum = currentTopics.reduce((m, t) => Math.max(m, Number(/^T-(\d+)$/.exec(t.id)?.[1] || 0)), 0) + 1;
                  id = T-;
                }

                topics.push({
                  id,
                  title: String(title),
                  department: validDept,
                  subDepartment: row['subdepartment'] || row['Sub-Department'] || row['sub department'] || '',
                  speaker: String(speaker || ''),
                  prerequisiteId: prerequisite ? String(prerequisite) : undefined,
                  venue: String(venue || ''),
                  description: String(description || ''),
                  durationMinutes: row['durationMinutes'] ? Number(row['durationMinutes']) : 60,
                  learningOutcomes: row['learningOutcomes'] ? String(row['learningOutcomes']).split(',').map(s => s.trim()).filter(s => s) : undefined,
                  tags: row.tags ? String(row.tags).split(',').map(s => s.trim()).filter(s => s) : undefined,
                  level: row.level ? String(row.level) as 'Fundamental' | 'Intermediate' | 'Advanced' | 'Executive' : undefined
                });
              });
            }
          } catch (err) {
            errors.push(Error parsing CSV: );
          }
        }

        resolve({ topics, errors });
      };
      reader.readAsText(file);
    });
  };

  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const result = await readAndParseFile(file);
    setParsedPreview(result.topics);
    setParseErrors(result.errors);
  };

  const handleApplyImport = () => {
    if (parsedPreview.length === 0) return;
    onImportTopics(parsedPreview, importMode);
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs">
      <div className="bg-slate-900 border border-slate-700 rounded-2xl max-w-3xl w-full p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
        <div className="flex items-center justify-between border-b border-slate-800 pb-3">
          <div className="flex items-center gap-2.5">
            <FileSpreadsheet className="w-5 h-5 text-emerald-400" />
            <div>
              <h2 className="text-base font-bold text-white tracking-tight">
                Import Training Topics
              </h2>
              <p className="text-xs text-slate-400">
                Paste rows copied from Excel / Google Sheets, or CSV text. You can also upload a CSV or Excel file.
              </p>
            </div>
          </div>
          <button onClick={onClose} className="p-1 rounded-lg bg-slate-800 text-slate-400 hover:text-white">✕</button>
        </div>

        <div className="p-3 bg-blue-950/40 border border-blue-800/40 rounded-xl flex items-center justify-between gap-4 text-xs">
          <div className="flex items-center gap-2 text-blue-200">
            <Sparkles className="w-4 h-4 text-blue-400 shrink-0" />
            <span>
              First row is a header. Required columns: <strong>title</strong>, <strong>department</strong> ({ALL_TRACK_DEPARTMENTS.join(', ')}).
              Optional: id, subdepartment, speaker, prerequisite (an id or exact title), venue, description.
            </span>
          </div>
          <button onClick={downloadTemplate} className="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg font-semibold shrink-0 transition-colors">
            Download Template
          </button>
        </div>

        {/* Raw Text Paste Area */}
        <div className="space-y-1.5">
          <div className="flex items-center justify-between text-xs text-slate-300">
            <label className="font-semibold">
              Paste table with header row
            </label>
            <span className="text-slate-500 font-mono text-[11px]">Tab, Comma, or Semicolon Separated</span>
          </div>
          <textarea
            rows={5}
            placeholder={TOPIC_TEMPLATE_HEADER.join('\t')}
            value={rawPastedText}
            onChange={(e) => setRawPastedText(e.target.value)}
            className="w-full bg-slate-950 border border-slate-700 rounded-xl p-3 text-xs font-mono text-slate-200 placeholder-slate-600 focus:outline-none focus:border-blue-500"
          />

          {/* File Upload Area */}
          <div className="mt-3 flex items-center justify-between rounded-xl px-3 py-2 bg-slate-800/50 border border-slate-700/50">
            <label className="flex items-center gap-2 cursor-pointer text-sm text-slate-300 hover:text-white transition-colors min-w-[200px]">
              <input
                type="file"
                accept=".csv,.tsv,.xlsx,.xls"
                onChange={handleFileChange}
                className="hidden"
              />
              <Upload className="w-4 h-4 text-blue-400 shrink-0" />
              <span>Upload CSV / Excel file</span>
            </label>
            <button onClick={() => fileInputRef.current?.click()} className="px-2 py-1 bg-emerald-600 text-white text-xs rounded hover:bg-emerald-500 transition-colors">
              Browse
            </button>
          </div>
        </div>

        {/* Action Buttons for parsing */}
        <div className="flex items-center justify-between">
          <button
            onClick={handleParseText}
            className="flex items-center gap-1.5 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-semibold border border-slate-700 transition-colors"
          >
            <ClipboardCheck className="w-4 h-4 text-emerald-400" />
            <span>Parse Copied Table</span>
          </button>

          <div className="flex items-center gap-4 text-xs text-slate-400">
            <span>Import Mode:</span>
            <label className="flex items-center gap-1.5 cursor-pointer">
              <input
                type="radio"
                name="importMode"
                checked={importMode === 'REPLACE'}
                onChange={() => setImportMode('REPLACE')}
                className="text-blue-500"
              />
              <span>Replace All</span>
            </label>
            <label className="flex items-center gap-1.5 cursor-pointer">
              <input
                type="radio"
                name="importMode"
                checked={importMode === 'APPEND'}
                onChange={() => setImportMode('APPEND')}
                className="text-blue-500"
              />
              <span>Append ({currentTopics.length} existing)</span>
            </label>
          </div>
        </div>

        {/* Parsing Errors if any */}
        {parseErrors.length > 0 && (
          <div className="p-3 bg-rose-950/40 border border-rose-800/50 rounded-xl text-xs text-rose-300 space-y-1">
            <div className="font-semibold flex items-center gap-1.5">
              <AlertCircle className="w-4 h-4 text-rose-400" />
              <span>Rejected rows:</span>
            </div>
            {parseErrors.map((err, idx) => (
              <div key={idx} className="text-[11px] text-rose-300/80 pl-5">
                • {err}
              </div>
            ))}
          </div>
        )}

        {/* Parsed Preview Table */}
        {parsedPreview.length > 0 && (
          <div className="space-y-2">
            <div className="flex items-center justify-between text-xs">
              <span className="font-semibold text-emerald-400 flex items-center gap-1.5">
                <CheckCircle className="w-4 h-4" />
                <span>{parsedPreview.length} topics ready to import</span>
              </span>
            </div>

            <div className="border border-slate-800 rounded-xl overflow-hidden max-h-48 overflow-y-auto">
              <table className="w-full text-left text-xs border-collapse">
                <thead className="bg-slate-950 sticky top-0 text-[11px] text-slate-400 uppercase">
                  <tr className="border-b border-slate-800">
                    <th className="py-2 px-3">Title</th>
                    <th className="py-2 px-3">Department</th>
                    <th className="py-2 px-3">Sub-Department</th>
                    <th className="py-2 px-3">Speaker</th>
                    <th className="py-2 px-3">Prereq</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/60 bg-slate-950/40">
                  {parsedPreview.map((item, idx) => (
                    <tr key={idx} className="hover:bg-slate-800/30">
                      <td className="py-1.5 px-3 font-medium text-slate-200">{item.title}</td>
                      <td className="py-1.5 px-3 text-slate-400">{item.department}</td>
                      <td className="py-1.5 px-3 text-slate-400">{item.subDepartment || '—'}</td>
                      <td className="py-1.5 px-3 text-slate-300">{item.speaker || '—'}</td>
                      <td className="py-1.5 px-3 font-mono text-purple-400 text-[11px]">
                        {item.prerequisiteId || '—'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {/* Modal Bottom Controls */}
        <div className="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
          <button onClick={onClose} className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-medium transition-colors">
            Cancel
          </button>
          <button
            onClick={handleApplyImport}
            disabled={parsedPreview.length === 0}
            className="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
          >
            Import {parsedPreview.length} Topics
          </button>
        </div>
      </div>
    </div>
  );
};